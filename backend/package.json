{
  "name": "aec-wartung-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend of the winter maintenance app (Hono + SQLite)",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env dist/src/index.js",
    "build": "rm -rf dist && tsc",
    "check": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "password-link": "node --env-file-if-exists=.env dist/src/cli.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0"
  }
}
